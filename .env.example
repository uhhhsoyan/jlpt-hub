# Copy to .env.local and fill in.

# Claude API key — console.anthropic.com → API keys.
# Powers sentence generation. (Separate from any claude.ai subscription.)
ANTHROPIC_API_KEY=

# Neon Postgres connection string — Vercel → Storage → Neon, or neon.tech.
# Needed to save/browse sentences; generation works without it.
DATABASE_URL=

# Vercel Blob read/write token — Vercel dashboard → project jlpt-hub → Storage →
# Create → Blob, then copy the token it gives you. Powers cloud storage for practice
# photos, sprint audio, and mined clips (so they survive a deploy, since public/ writes
# don't). Without it, media falls back to local public/ paths — fine for `npm run dev`,
# but won't work once deployed.
BLOB_READ_WRITE_TOKEN=

# WaniKani personal access token — wanikani.com/settings/personal_access_tokens.
# Powers the "Sync WaniKani" progress import and the schedule's level tracking;
# read-only default permissions are enough.
WANIKANI_TOKEN=

# Shared secret for the daily WaniKani cron (/api/cron/wanikani, see vercel.json).
# Set the same value in the Vercel project env; Vercel Cron sends it as a Bearer token.
# Any long random string: `openssl rand -hex 32`.
CRON_SECRET=

# Listening Mine (local only). Path to a whisper.cpp ggml model, e.g.
# ~/models/ggml-large-v3-turbo.bin. See SETUP.md for install.
WHISPER_MODEL=
# Optional: override the whisper CLI (default: whisper-cli).
WHISPER_CLI=

# Study-ledger MCP endpoint (/mcp). One long random bearer token shared by every client:
# the claude.ai custom connector, Claude Code's .mcp.json, anything else. Set the same
# value in the Vercel project env. Unset = the endpoint refuses everything.
# Generate: `openssl rand -hex 32`
MCP_TOKEN=

# Hindsight memory add-on (optional; docs/plans/07-hindsight.md). Local container (M2):
# HINDSIGHT_API_KEY is the bearer token the container is started with (scripts/hindsight.sh);
# HINDSIGHT_UI_ACCESS_KEY is the web UI login. Generate both: `openssl rand -hex 32`.
HINDSIGHT_API_KEY=
HINDSIGHT_UI_ACCESS_KEY=
# Phase B, set in the Vercel project env only: the tunnel hostnames and the Cloudflare
# Access service token the Hub sends when calling recall/reflect. HINDSIGHT_URL unset =
# the memory tools answer "unconfigured" and the Progress page shows no graph link.
HINDSIGHT_URL=
HINDSIGHT_UI_URL=
HINDSIGHT_BANK=jlpt-study
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
